# Copy to .env and fill in. Never commit .env.

# Dedicated database on the existing Postgres server (port 5433).
# Create it with scripts/create-db.sql first.
DATABASE_URL="postgresql://allotment:CHANGE_ME@localhost:5433/allotment?schema=public"

PORT=3000
HOST=127.0.0.1

# Generate with: npm run gen-keys
# Losing PAN_ENC_KEY means stored PANs can no longer be decrypted — back it up safely.
JWT_SECRET=
PAN_ENC_KEY=
PAN_HMAC_KEY=

# Set to true when served over HTTPS
COOKIE_SECURE=false
